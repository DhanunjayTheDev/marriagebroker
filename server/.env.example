# ─────────────────────────────────────────
# APP
# ─────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=Avyuktha Matrimony
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
API_VERSION=v1

# ─────────────────────────────────────────
# MONGODB
# ─────────────────────────────────────────
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@marriagebroker.6nll6hj.mongodb.net/?appName=marriagebroker
MONGODB_DB_NAME=avyuktha

# ─────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────
# Set true only when running a real Redis (multi-instance / async queues).
# false = in-memory fallback (OTP, cache, rate-limit, presence)  MongoDB-only dev.
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_URL=redis://127.0.0.1:6379

# ─────────────────────────────────────────
# JWT
# ─────────────────────────────────────────
JWT_ACCESS_SECRET=your_access_secret_min_64_chars_here
JWT_REFRESH_SECRET=your_refresh_secret_min_64_chars_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
JWT_RESET_SECRET=your_reset_secret_here
JWT_RESET_EXPIRY=1h
JWT_EMAIL_VERIFY_SECRET=your_email_verify_secret_here
JWT_EMAIL_VERIFY_EXPIRY=24h

# ─────────────────────────────────────────
# ENCRYPTION
# ─────────────────────────────────────────
ENCRYPTION_KEY=your_32_char_encryption_key_here
HASH_SALT_ROUNDS=12

# ─────────────────────────────────────────
# OTP
# ─────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ─────────────────────────────────────────
# GOOGLE / OAUTH
# ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ─────────────────────────────────────────
# FIREBASE
# ─────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_firebase_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_firebase_client_id

# ─────────────────────────────────────────
# GOOGLE CLOUD STORAGE
# ─────────────────────────────────────────
GCS_PROJECT_ID=your_gcs_project_id
GCS_KEY_FILE_PATH=./gcs-service-account.json
GCS_PUBLIC_BUCKET=avyuktha-public
GCS_PRIVATE_BUCKET=avyuktha-private
GCS_CDN_URL=https://cdn.avyuktha.com

# ─────────────────────────────────────────
# AGORA RTC
# ─────────────────────────────────────────
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGORA_TOKEN_EXPIRY_SECONDS=3600

# ─────────────────────────────────────────
# RAZORPAY
# ─────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─────────────────────────────────────────
# CASHFREE
# ─────────────────────────────────────────
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=TEST
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret

# ─────────────────────────────────────────
# EMAIL (SMTP)
# ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@avyuktha.com
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM_NAME=Avyuktha Matrimony
EMAIL_FROM_ADDRESS=noreply@avyuktha.com

# ─────────────────────────────────────────
# SMS (TWILIO)
# ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid

# ─────────────────────────────────────────
# WHATSAPP (TWILIO / WABA)
# ─────────────────────────────────────────
WHATSAPP_PROVIDER=twilio
WHATSAPP_FROM=whatsapp:+14155238886
WABA_PHONE_NUMBER_ID=your_waba_phone_number_id
WABA_ACCESS_TOKEN=your_waba_access_token

# ─────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_PAYMENT_MAX=10

# ─────────────────────────────────────────
# SESSION
# ─────────────────────────────────────────
SESSION_SECRET=your_session_secret_here
MAX_ACTIVE_SESSIONS=5

# ─────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# ─────────────────────────────────────────
# CORS
# ─────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://avyuktha.com

# ─────────────────────────────────────────
# ADMIN
# ─────────────────────────────────────────
ADMIN_EMAIL=admin@avyuktha.com
ADMIN_DEFAULT_PASSWORD=Admin@123!

# ─────────────────────────────────────────
# AI
# ─────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
AI_MODEL=gpt-4o
AI_MAX_TOKENS=2000

# ─────────────────────────────────────────
# BULL BOARD
# ─────────────────────────────────────────
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=bullboard_password

# ─────────────────────────────────────────
# GCP CLOUD SCHEDULER
# ─────────────────────────────────────────
GCP_SCHEDULER_REGION=asia-south1
GCP_SCHEDULER_SERVICE_ACCOUNT=scheduler@your-project.iam.gserviceaccount.com
